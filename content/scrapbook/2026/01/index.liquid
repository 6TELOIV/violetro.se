<style>
    main>.container--lg {
        overflow-x: hidden;
    }
    h1 {
        color: rebeccapurple;
        font-variant: small-caps;
        text-align: center;
    }

    .scrapbook-wrapper {
        display: grid;
        gap: 10px;
    }

    .scrapbook-page {
        border: 1px solid currentColor;
        box-shadow: 0 10px 20px #0008;
        display: grid;
        gap: 10px;
        padding: 10px;
        background: wheat;
        color: rebeccapurple;
        margin-block: 1rem;
    }

    .scrapbook-page * {
        margin: 0;
    }

    .scrapbook-page img {
        display: block;
    }

    .scrapbook-heading {
        display: flex;
        gap: 10px;
        margin-inline: auto;
    }

    .scrapbook-heading h2,
    .scrapbook-heading h3,
    .scrapbook-heading h4,
    .scrapbook-heading h5,
    .scrapbook-heading h6 {
        font-variant: small-caps;
        text-align: center;
    }

    .scrapbook-photo-grid {
        display: grid;
        gap: 10px;
    }

    @media screen and (min-width: 576px) {
        .scrapbook-photo-grid {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(auto-fill, minmax(288px, 1fr));
        }
    }

    .scrapbook-figure {
        transition: transform 200ms;
        display: grid;
        transform: rotate(-5deg);
        box-shadow: 0 10px 20px #0008;
        background-color: white;
        padding: 5px;
        align-self: center;
    }

    .scrapbook-figure-caption {
        padding: 5px 10px;
        text-align: center;
    }

    .scrapbook-photo {
        position: relative;
    }

    .scrapbook-photo-tack {
        width: 20%;
        height: 20%;
        object-fit: contain;
        position: absolute;
        top: 0;
        right: 0;
        transform: translateX(33%) translateY(-33%) rotate(5deg);
    }

    .scrapbook-photo-sticker {
        width: 30%;
        height: 30%;
        object-fit: contain;
        position: absolute;
        bottom: 0;
        left: 0;
        transform: translateX(-33%) translateY(33%) rotate(5deg);
    }

    .scrapbook-figure:nth-child(2) .scrapbook-photo-tack {
        filter: hue-rotate(250deg);
    }

    .scrapbook-figure:nth-child(3) .scrapbook-photo-tack {
        filter: hue-rotate(60deg) saturate(200%) brightness(125%);
    }

    .scrapbook-figure:nth-child(4) .scrapbook-photo-tack {
        filter: hue-rotate(100deg) brightness(150%);
    }

    .scrapbook-figure:nth-child(5) .scrapbook-photo-tack {
        filter: hue-rotate(200deg) brightness(150%);
    }

    .scrapbook-figure:nth-child(6) .scrapbook-photo-tack {
        filter: hue-rotate(300deg) saturate(80%);
    }

    .scrapbook-figure:nth-child(2n) {
        transform: rotate(5deg);
    }

    .scrapbook-figure:nth-child(2n) .scrapbook-photo-tack {
        left: 0;
        right: unset;
        transform: translateX(-33%) translateY(-33%) scaleX(-1) rotate(-5deg);
    }

    .scrapbook-figure:nth-child(2n) .scrapbook-photo-sticker {
        left: unset;
        right: 0;
        transform: translateX(33%) translateY(33%) rotate(-5deg);
    }

    .scrapbook-figure:hover {
        transform: rotate(0);
    }
</style>
